#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#include <behaviors/custom_config.dtsi>
#include <behaviors/meteorite_custom_key.dtsi>
#include <behaviors/meteorite_bt_os.dtsi>
#include <behaviors/meteorite_mod_key.dtsi>
#include <behaviors/meteorite_os_key.dtsi>
#include <dt-bindings/zmk/custom_config.h>
#include <dt-bindings/zmk/meteorite_custom_keys.h>
#include <dt-bindings/zmk/meteorite_bt_os.h>

&mt {
    flavor = "tap-preferred"; // change hold to tap
    tapping-term-ms = <200>;
    quick-tap-ms = <150>; // change 200 to 150
};

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>; // change 200 to 150
    quick-tap-ms = <150>; // change 200 to 150
    require-prior-idle-ms = <150>; // 高速タイピング中はタップ優先
};

/ {
    behaviors {
        lt_emacs: lt_emacs {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <0>;
            bindings = <&mo>, <&kp>;
            display-name = "Emacs layer-tap (tap-preferred, no prior-idle)";
        };

        mck_mt: mck_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mck>, <&kp>;
            display-name = "meteorite OS-Switch-mod-tap";
        };

        mck_mt_st: mck_mt_st {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            bindings = <&mck>, <&alt_cmd_tab>;
            display-name = "meteorite OS-Switch-mod-tap (smart toggle)";
        };

        alt_cmd_tab: alt_cmd_tab {
            compatible = "zmk,behavior-smart-toggle";
            #binding-cells = <0>;
            display-name = "meteorite Smart toggle (Alt/Cmd+Tab)";
            bindings = <&mck M_OS_ALT_CMD>, <&kp TAB>;
            position-bindings = <12 13>; /* D, F */
            position-binding-behaviors = <&kp LS(TAB)>, <&kp TAB>;
        };
    };

    macros {
        kill_line: kill_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(END) &kp DEL>;
        };

        ctrl_click: ctrl_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&mkp MB1>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        ctrl_rclick: ctrl_rclick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&mkp MB2>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lang1 {
            bindings = <&kp LANG1>;
            key-positions = <12 13>; /* D + F */
            layers = <0>;
        };

        lang2 {
            bindings = <&kp LANG2>;
            key-positions = <16 17>; /* J + K */
            layers = <0>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <20 21>; /* Z + X */
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>; /* Q + W */
            layers = <0>;
        };

        line_home {
            bindings = <&mosk HOME LG(LEFT)>;
            key-positions = <16 17>; /* J + K (on layer 2) */
            layers = <2>;
        };

        line_end {
            bindings = <&mosk END LG(RIGHT)>;
            key-positions = <18 19>; /* L + - (on layer 2) */
            layers = <2>;
        };

        doc_home {
            bindings = <&mosk LC(HOME) LG(UP)>;
            key-positions = <16 18>; /* J + L (on layer 2) */
            layers = <2>;
        };

        doc_end {
            bindings = <&mosk LC(END) LG(DOWN)>;
            key-positions = <17 19>; /* K + - (on layer 2) */
            layers = <2>;
        };

        ctrl_alt_delete {
            bindings = <&kp LC(LA(DELETE))>;
            key-positions = <2 3 4>;
        };

        win {
            bindings = <&kp LEFT_WIN>;
            key-positions = <5 6 7>;
        };

        alt_f4 {
            bindings = <&kp LA(F4)>;
            key-positions = <1 32>;
        };

        snipping_tool {
            bindings = <&kp LS(LG(S))>;
            key-positions = <25 26>;
        };

        l_semi_enter {
            bindings = <&kp ENTER>;
            key-positions = <18 19>; /* L + ; */
            layers = <0>;
        };

        aqua_voice {
            bindings = <&kp RALT>;
            key-positions = <17 18>; /* K + L */
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layout = &LOW_PROFILE_DEFAULT;

        win_default_layer {
            display-name = "BASE";
            bindings = <
&kp Q             &kp W      &kp E             &kp R        &kp T             &kp Y        &kp U      &kp I       &kp O  &kp P
&lt_emacs 5 A    &kp S      &kp D             &kp F        &kp G             &kp H        &kp J      &kp K       &kp L  &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X      &kp C             &kp V        &kp B             &mkp MB1     &mkp MB2   &kp N       &kp M  &kp COMMA      &kp DOT  &lt 4 SLASH
&kp LALT          &kp LCTRL  &mt LSHIFT SPACE  &lt 3 GRAVE  &mt LSHIFT SPACE  &lt 1 MINUS  &kp ENTER  &kp DELETE
            >;
        };

        layer_1 {
            display-name = "SYMBOLS";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5         &kp NUMBER_6  &kp N7     &kp N8            &kp N9             &kp N0
&none         &none         &none         &none         &kp GRAVE      &kp MINUS     &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SINGLE_QUOTE
&none         &none         &none         &none         &kp LS(GRAVE)  &mkp MB4      &mkp MB5   &kp LS(MINUS)     &kp LS(EQUAL)      &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp BACKSLASH
&trans        &trans        &trans        &trans        &trans         &trans        &trans     &trans
            >;
        };

        layer_2 {
            display-name = "NUM / ARROW";
            bindings = <
                &kp ASTRK        &kp N7     &kp N8     &kp N9     &kp PLUS                        &none  &none     &none   &kp C_VOL_DN &kp C_VOL_UP
                &kp SLASH        &kp N4     &kp N5     &kp N6     &kp MINUS                       &none  &kp LEFT  &kp UP  &kp DOWN     &kp RIGHT
                &kp N0           &kp N1     &kp N2     &kp N3     &kp DOT   &mkp MB4   &mkp MB5   &none  &none     &none   &none        &none
                                        &trans           &trans     &trans     &trans    &trans        &trans  &trans    &trans
            >;
        };

        layer_3 {
            display-name = "FUNCTION";
            bindings = <
&none     &kp UP_ARROW  &none      &none   &none   &kp LC(LS(TAB))  &kp PAGE_UP       &kp PAGE_DOWN  &kp LC(TAB)    &kp HOME
&kp LEFT  &kp DOWN      &kp RIGHT  &none   &none   &kp LC(LEFT)     &kp LC(UP_ARROW)  &kp LC(DOWN)   &kp LC(RIGHT)  &kp END
&kp F1    &kp F2        &kp F3     &kp F4  &kp F5  &kp F11          &kp F12           &kp F6         &kp F7         &kp F8    &kp F9  &kp F10
&trans    &trans        &trans     &trans  &trans  &trans           &trans            &trans
            >;
        };

        layer_4 {
			display-name = "SETTING";
			bindings = <
				&ccfg C_CPI_DN  &ccfg C_CPI_UP  &ccfg C_ROT_DN   &ccfg C_ROT_UP   &ccfg C_SCALE_TOG                        &bt BT_SEL 0   &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
				&ccfg C_SDIV_DN &ccfg C_SDIV_UP &ccfg C_SCRH_TOG &ccfg C_SCRV_TOG &ccfg C_SCRL_SCALE_TOG                   &bt BT_CLR     &bt BT_CLR_ALL  &none         &none         &none
				&ccfg C_SAVE    &ccfg C_RESET   &none            &none            &ccfg C_SCRL2_UP         &none  &none    &bootloader    &none           &none         &none         &none
												                    &trans       &trans  &trans  &trans  &trans  &trans    &trans        &trans
			>;
        };

        layer_5 {
            display-name = "EMACS";
            bindings = <
&kp LC(Q)  &kp LC(BSPC)  &kp END    &kp LC(R)  &kp LC(T)  &kp LC(V)    &kp LC(U)     &kp LC(I)   &kp LC(O)  &kp UP
&none      &kp HOME      &kp DEL    &kp RIGHT  &kp LC(G)  &kp BSPC     &kp LC(J)     &kill_line  &kp LC(L)  &kp LC(MINUS)
&kp LC(Z)  &kp LC(X)     &kp LC(C)  &kp LC(V)  &kp LEFT   &ctrl_click  &ctrl_rclick  &kp DOWN    &kp ENTER  &kp LC(COMMA)  &kp LC(DOT)  &kp LC(SLASH)
&trans     &trans        &trans     &trans     &trans     &trans       &trans        &trans
            >;
        };
    };
};
